{
  "name": "telegram-video-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Bot Telegram independente para download de vídeos do YouTube com seleção de qualidade",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "telegraf": "4.16.3"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
