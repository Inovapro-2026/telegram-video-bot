# Copie este arquivo para .env e preencha apenas o que for necessário.
# NUNCA commite o .env com o token preenchido.

TELEGRAM_BOT_TOKEN=

# Limite de envio de arquivos pela Bot API do Telegram (padrão: 47 MiB ≈ 49,3 MB, abaixo de 50 MB).
MAX_FILE_SIZE_MB=47

# Controle de recursos
MAX_CONCURRENT_DOWNLOADS=1
DOWNLOAD_TIMEOUT_SECONDS=900
MAX_REQUESTS_PER_MINUTE=5
SESSION_TTL_MINUTES=15
TEMP_MAX_AGE_HOURS=6

# Diretório temporário (relativo à raiz do projeto ou absoluto)
TEMP_DIR=temp

# Opcional: IDs separados por vírgula. Vazio = bot público.
ALLOWED_USER_IDS=

# Recursos opcionais / caminhos dos binários
ENABLE_MP3=true
DROP_PENDING_UPDATES=true
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
